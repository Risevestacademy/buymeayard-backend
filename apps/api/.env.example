# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Database (PostgreSQL - starts with `pnpm db:up`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buymeayard?schema=public

# Redis (starts with `pnpm db:up`)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-this-to-a-super-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Optional: Only needed if using @better-auth/infra cloud dashboard
# BETTER_AUTH_API_KEY=your_infra_api_key_here

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=xxx

# Email Providers
# 1. Brevo HTTPS API (Recommended for Render/Railway free tier - port 443)
BREVO_API_KEY=xkeysib-xxx

# 2. SMTP (Gmail or custom SMTP - port 465 or 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=xxx@gmail.com
# SMTP_PASS=xxx

EMAIL_FROM="BuyMeAYard <buymeayard@gmail.com>"

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Seeded super admin (prisma/seed.ts). Required with a strong value when
# NODE_ENV=production; the dev default (admin@buymeayard.com /
# AdminPassword123!) is for local development only.
# ADMIN_EMAIL=admin@buymeayard.com
# ADMIN_PASSWORD=

# Frontends
CREATOR_FRONTEND_URL=http://localhost:3001

# KYC (Didit) - required when NODE_ENV=production
# API key: Didit Console > API & Webhooks. Workflow ID: Console > Workflows.
# Webhook secret: the destination's secret_shared_key.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me
# Deep link the mobile app handles after the hosted flow returns
KYC_MOBILE_CALLBACK_URL=buymeayard://kyc/complete
KYC_MAX_SESSIONS_PER_DAY=5
# Checks that must each pass before a Didit "Approved" is accepted; otherwise
# the case goes to admin review. Subset of ID_VERIFICATION,LIVENESS,FACE_MATCH.
KYC_REQUIRED_CHECKS=ID_VERIFICATION,LIVENESS,FACE_MATCH

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=10
DEFAULT_CURRENCY=NGN


# PostHog Analytics (Optional)
# POSTHOG_API_KEY=phc_your_actual_key_here
# POSTHOG_HOST=https://us.i.posthog.com