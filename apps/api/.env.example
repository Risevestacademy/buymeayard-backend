# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Database (PostgreSQL - starts with `pnpm db:up`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buymeayard?schema=public

# Redis (starts with `pnpm db:up`)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-this-to-a-super-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Optional: Only needed if using @better-auth/infra cloud dashboard
# BETTER_AUTH_API_KEY=your_infra_api_key_here

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@buymeayard.com

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=10
DEFAULT_CURRENCY=NGN
